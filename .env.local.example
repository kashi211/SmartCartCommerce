# OpenAI — for generation (gpt-4o-mini) and embeddings (text-embedding-3-small)
OPENAI_API_KEY=sk-proj-...

# Pinecone — for vector storage
# Get your key at https://app.pinecone.io
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=smartcart-kb

# Knowledge base path (relative to project root, or absolute)
KB_PATH=data/kb

# Braintrust — for RAG evaluation (npm run eval)
# Get your key at https://www.braintrust.dev
BRAINTRUST_API_KEY=sk-brainrust-...

# LangSmith — for production observability and tracing
# Get your key at https://smith.langchain.com
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=smartcart-rag
